{
  "name": "@mansomirror/desktop",
  "productName": "MansoMirror",
  "version": "0.3.7",
  "private": true,
  "description": "MansoMirror Desktop — partage d'écran sécurisé entre ordinateurs sur le réseau local.",
  "author": "Manso",
  "main": "dist/main.js",
  "devDependencies": {
    "@electron/fuses": "2.1.3",
    "@mansomirror/design-tokens": "workspace:*",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "bonjour-service": "1.4.4",
    "electron": "45.2.3",
    "electron-builder": "26.18.0",
    "electron-updater": "^6.8.11",
    "esbuild": "0.28.2",
    "playwright": "1.63.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^7.0.2",
    "ws": "8.22.2"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit -p .",
    "test": "node --test \"test/unit/**/*.test.ts\"",
    "test:e2e": "node scripts/build.mjs && node --test --test-force-exit --test-concurrency=1 \"test/e2e/**/*.test.mjs\"",
    "dist": "node scripts/fetch-scrcpy.mjs && node scripts/build.mjs && electron-builder --publish never"
  },
  "homepage": "https://github.com/AzmoWeb/MansoMiror",
  "desktopName": "mansomirror.desktop"
}
